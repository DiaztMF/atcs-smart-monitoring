# Smart Traffic Monitoring - Frontend Environment Variables
# Copy this file to .env.local for local development, or add these keys to Vercel Environment Variables.

# Backend REST API URL (HTTPS on production, HTTP on local)
# Example Production: https://atcs-smart-monitoring-backend.onrender.com
# Example Local: http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=https://atcs-smart-monitoring-backend.onrender.com

# Backend WebSocket Stream URL (WSS on production, WS on local)
# Note: The system will automatically force WSS protocol in production even if ws:// is provided.
# Example Production: wss://atcs-smart-monitoring-backend.onrender.com/ws/metrics
# Example Local: ws://localhost:8000/ws/metrics
NEXT_PUBLIC_WS_URL=wss://atcs-smart-monitoring-backend.onrender.com/ws/metrics
